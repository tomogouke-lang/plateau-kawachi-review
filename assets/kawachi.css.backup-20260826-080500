@import url("tokens.css");

:root{
  --forest:#24473B;
  --forest-deep:#173129;
  --leaf:#5D7D66;
  --wood:#9A5C35;
  --wood-soft:#F1E5D8;
  --mist:#F3F6F1;
  --paper:#FFFDF8;
  --ink:#14172B;
}

*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--pds-font-body);font-size:18px;line-height:1.9;word-break:auto-phrase;}
img{display:block;width:100%;height:100%;object-fit:cover;}
a{color:inherit;}
button,select,input{font:inherit;}
.skip{position:absolute;left:-9999px;top:8px;z-index:100;background:#fff;padding:12px 16px;}
.skip:focus{left:8px;}
.draft-banner{background:var(--pds-warning-bg);color:#5E410F;padding:8px 16px;text-align:center;font-size:14px;font-weight:700;}
.inner{width:min(1120px,calc(100% - 48px));margin-inline:auto;}
.site-nav{position:sticky;top:0;z-index:30;background:rgba(255,253,248,.96);border-bottom:1px solid var(--pds-border);backdrop-filter:blur(12px);}
.nav-row{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px;}
.brand{text-decoration:none;font:900 20px/1.4 var(--pds-font-ui);}
.brand small{display:block;color:var(--forest);font-size:14px;letter-spacing:.12em;}
.nav-links{display:flex;align-items:center;gap:24px;font-weight:700;}
.nav-links a{text-decoration:none;}
.nav-cta{min-height:48px;padding:0 16px;border-radius:8px;display:inline-flex;align-items:center;background:var(--pds-primary);color:#fff;}

.hero{position:relative;min-height:720px;display:grid;align-items:end;overflow:hidden;background:var(--forest-deep);}
.hero-media{position:absolute;inset:0;}
.hero-media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,36,31,.78) 0%,rgba(20,36,31,.30) 56%,rgba(20,36,31,.04) 100%);}
.hero-media img{object-position:center 52%;}
.hero-copy{position:relative;z-index:1;padding-block:96px;}
.hero-paper{width:min(700px,100%);padding:48px;border-left:8px solid #D3A06D;background:rgba(255,253,248,.94);box-shadow:0 32px 80px rgba(0,0,0,.25);}
.eyebrow{display:inline-block;color:var(--wood);font:900 14px/1.4 var(--pds-font-ui);letter-spacing:.12em;text-transform:uppercase;}
.hero h1,.practical-hero h1{font:900 clamp(40px,6vw,68px)/1.28 var(--pds-font-ui);margin:12px 0 24px;color:var(--forest-deep);}
.hero-lead{font-size:20px;margin:0 0 32px;max-width:620px;}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;}
.btn{min-height:48px;min-width:88px;padding:0 16px;border:2px solid transparent;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-weight:700;}
.btn-primary{background:var(--pds-primary);color:#fff;}
.btn-secondary{background:#fff;color:var(--pds-primary);border-color:var(--pds-primary);}

.fact-strip{background:var(--forest-deep);color:#fff;}
.fact-strip-grid{display:grid;grid-template-columns:1.2fr .8fr 1fr 1.4fr;}
.fact-strip-item{padding:24px;border-left:1px solid rgba(255,255,255,.18);}
.fact-strip-item:last-child{border-right:1px solid rgba(255,255,255,.18);}
.fact-strip-item span{display:block;color:#D7E6DC;font-size:14px;font-weight:700;}
.fact-strip-item strong{display:block;margin-top:4px;font:900 22px/1.5 var(--pds-font-ui);}

section{padding-block:80px;}
.mist{background:var(--mist);}
.wood-soft{background:var(--wood-soft);}
.section-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,520px);gap:48px;align-items:end;margin-bottom:48px;}
.section-head>*{min-width:0;}
.section-head h2{font:900 clamp(32px,4vw,48px)/1.35 var(--pds-font-ui);margin:8px 0 0;color:var(--forest-deep);}
.section-head p{margin:0;color:var(--pds-text-sub);}

.fit-layout{display:grid;grid-template-columns:1.12fr .88fr;gap:24px;align-items:stretch;}
.fit-main{padding:40px;border-radius:14px;background:var(--forest-deep);color:#fff;}
.fit-main h3{font:900 32px/1.45 var(--pds-font-ui);margin:8px 0 24px;}
.fit-main ul{margin:0;padding-left:24px;}
.fit-main li+li{margin-top:12px;}
.fit-side{display:grid;gap:16px;}
.fit-card{padding:32px;border-radius:14px;background:#fff;border:1px solid var(--pds-border);}
.fit-card strong{display:block;font:900 24px/1.5 var(--pds-font-ui);color:var(--forest);}
.fit-card p{margin:12px 0 0;}
.mismatch{margin-top:24px;padding:24px 32px;border-left:8px solid var(--pds-warning);border-radius:8px;background:var(--pds-warning-bg);}

.room-story{display:grid;grid-template-columns:1.24fr .76fr;gap:0;align-items:stretch;}
.room-photo{min-height:600px;overflow:hidden;border-radius:14px 0 0 14px;}
.room-copy{padding:48px;background:#fff;border:1px solid var(--pds-border);border-left:0;border-radius:0 14px 14px 0;display:flex;flex-direction:column;justify-content:center;}
.room-copy h2,.bath-copy h2{font:900 40px/1.4 var(--pds-font-ui);margin:8px 0 24px;color:var(--forest-deep);}
.vertical-label{font:900 18px/1.2 var(--pds-font-ui);color:var(--wood);letter-spacing:.18em;writing-mode:vertical-rl;position:absolute;right:16px;top:16px;}
.room-copy-wrap{position:relative;}

.scene-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
.scene-card{margin:0;overflow:hidden;border:1px solid var(--pds-border);border-radius:14px;background:#fff;box-shadow:0 16px 40px rgba(23,49,41,.08);}
.scene-card img{aspect-ratio:4/3;height:auto;object-position:center;}
.scene-card figcaption{display:grid;gap:8px;padding:24px;}
.scene-card strong{font:900 24px/1.4 var(--pds-font-ui);color:var(--forest-deep);}
.scene-card span{color:var(--pds-text-sub);}
.photo-note{margin:16px 0 0;color:var(--pds-text-muted);font-size:14px;}

.bath-layout{display:grid;grid-template-columns:.82fr 1.18fr;gap:48px;align-items:center;}
.bath-layout>*{min-width:0;}
.bath-copy{padding:40px;background:var(--paper);border-top:8px solid var(--wood);border-radius:14px;box-shadow:0 24px 64px rgba(74,53,34,.12);}
.bath-photo{min-height:560px;border-radius:14px;overflow:hidden;box-shadow:0 24px 64px rgba(74,53,34,.16);}
.bath-points{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:24px;}
.bath-point{padding:16px;border-radius:8px;background:#fff;border:1px solid #E1C8B0;}
.bath-point strong{display:block;color:var(--wood);}

.day-flow{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--pds-border);border-bottom:1px solid var(--pds-border);}
.day-step{min-height:210px;padding:24px 16px;border-left:1px solid var(--pds-border);}
.day-step:first-child{border-left:0;}
.day-step time{display:block;color:var(--forest);font-weight:900;font-variant-numeric:tabular-nums;}
.day-step strong{display:block;font:700 20px/1.5 var(--pds-font-ui);margin:8px 0;}

.availability-wrap{max-width:100%;overflow-x:auto;border:1px solid var(--pds-border);border-radius:14px;background:#fff;}
.availability-table,.fact-table,.acceptance-table{width:100%;border-collapse:collapse;background:#fff;table-layout:fixed;}
.availability-table{min-width:600px;}
.availability-table th,.availability-table td,.fact-table th,.fact-table td,.acceptance-table th,.acceptance-table td{padding:16px;border-bottom:1px solid var(--pds-border);text-align:left;vertical-align:top;}
.availability-table thead th,.acceptance-table thead th{background:#14172B;color:#fff;}
.availability-table tbody th{width:24%;background:#E4EEE7;color:var(--forest-deep);}
.availability-table td{height:64px;}
.status{display:inline-flex;align-items:center;min-height:36px;padding:4px 12px;border-radius:999px;font-weight:700;}
.status-many{color:var(--pds-success);background:var(--pds-success-bg);}
.status-few{color:var(--pds-warning);background:var(--pds-warning-bg);}
.status-none{color:var(--pds-danger);background:var(--pds-danger-bg);}
.status-info{color:var(--pds-info);background:var(--pds-info-bg);}
.availability-message{padding:24px;margin:0;color:var(--pds-text-sub);}

.simulator{display:grid;grid-template-columns:1.05fr .95fr;gap:24px;align-items:start;}
.simulator>*{min-width:0;}
.sim-panel,.result-panel{padding:24px;border:1px solid var(--pds-border);border-radius:14px;background:#fff;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px 16px;}
.field{display:grid;gap:8px;font-weight:700;}
.field select{width:100%;min-height:48px;padding:0 12px;border:1px solid var(--pds-border-input);border-radius:8px;background:#fff;color:var(--ink);}
.field-wide{grid-column:1/-1;}
.check-field{display:flex;align-items:center;gap:12px;min-height:48px;font-weight:700;}
.check-field input{width:24px;height:24px;accent-color:var(--pds-primary);}
.hidden{display:none!important;}
.result-panel{position:sticky;top:96px;background:var(--forest-deep);color:#fff;}
.result-panel h3{margin:0;font:700 20px var(--pds-font-ui);}
.total{margin:16px 0;color:#F2C99F;font:900 clamp(40px,6vw,64px)/1.2 var(--pds-font-ui);font-variant-numeric:tabular-nums;}
.breakdown{list-style:none;padding:0;margin:0;}
.breakdown li{display:flex;justify-content:space-between;gap:24px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.18);}
.breakdown b{text-align:right;font-variant-numeric:tabular-nums;}
.notice{margin-top:24px;padding:24px;border-radius:14px;background:var(--pds-warning-bg);color:#5E410F;}
.notice strong{display:block;margin-bottom:8px;}

.facts-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:48px;align-items:start;}
.facts-photo{min-height:560px;border-radius:14px;overflow:hidden;}
.fact-table th{width:34%;color:var(--pds-text-sub);}
.fact-table td{overflow-wrap:anywhere;}
.source-note{font-size:14px;color:var(--pds-text-muted);margin-top:16px;}
.contact-band{background:#181A33;color:#fff;}
.contact-row{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;}
.contact-row>*{min-width:0;}
.contact-row h2{font:900 36px/1.4 var(--pds-font-ui);margin:8px 0;}
.phone{font:900 clamp(28px,4vw,44px)/1.2 var(--pds-font-ui);text-decoration:none;font-variant-numeric:tabular-nums;}
footer{padding:32px 0;background:#0E1022;color:#fff;font-size:14px;}

.practical-hero{padding-block:72px;background:linear-gradient(125deg,#E5EEE7,#FFFDF8 72%);border-bottom:1px solid var(--pds-border);}
.practical-hero p{max-width:820px;margin:16px 0 0;}
.quick-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px;}
.quick-fact{padding:24px;border:1px solid var(--pds-border);border-radius:14px;background:#fff;}
.quick-fact span{display:block;color:var(--pds-text-sub);font-size:14px;font-weight:700;}
.quick-fact strong{display:block;margin-top:8px;font:900 20px/1.5 var(--pds-font-ui);}
.acceptance-table th:first-child{width:26%;}
.acceptance-table td:nth-child(2){width:20%;font-weight:900;}
.cm-story{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:center;}
.cm-story-photo{min-height:520px;border-radius:14px;overflow:hidden;}
.cm-story h2{font:900 40px/1.4 var(--pds-font-ui);color:var(--forest-deep);}
.cm-points{display:grid;gap:16px;}
.cm-point{padding:24px;border-left:8px solid var(--leaf);border-radius:8px;background:#fff;}
.cm-point strong{display:block;font:900 22px/1.4 var(--pds-font-ui);color:var(--forest);}

@media(max-width:900px){
  .nav-links a:not(.nav-cta){display:none;}
  .section-head,.fit-layout,.room-story,.bath-layout,.simulator,.facts-grid,.contact-row,.cm-story{grid-template-columns:1fr;}
  .fact-strip-grid,.quick-facts{grid-template-columns:1fr 1fr;}
  .room-photo{min-height:520px;border-radius:14px 14px 0 0;}
  .room-copy{border-left:1px solid var(--pds-border);border-top:0;border-radius:0 0 14px 14px;}
  .result-panel{position:static;}
  .scene-grid{grid-template-columns:1fr 1fr;}
}

@media(max-width:620px){
  .inner{width:min(100% - 32px,1120px);}
  .hero{min-height:640px;}
  .hero-copy{padding-block:48px;}
  .hero-paper{padding:32px 24px;}
  .fact-strip-grid,.quick-facts,.form-grid,.day-flow,.bath-points{grid-template-columns:1fr;}
  .scene-grid{grid-template-columns:1fr;}
  .fact-strip-item{border-right:1px solid rgba(255,255,255,.18);}
  section{padding-block:64px;}
  .section-head{gap:16px;margin-bottom:32px;}
  .fit-main,.room-copy,.bath-copy{padding:24px;}
  .room-photo,.bath-photo,.facts-photo,.cm-story-photo{min-height:360px;}
  .vertical-label{display:none;}
  .day-step{min-height:auto;border-left:0;border-bottom:1px solid var(--pds-border);}
  .contact-row{gap:24px;}
  .breakdown li{display:grid;gap:4px;}
  .breakdown b{text-align:left;}
}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto;}}
